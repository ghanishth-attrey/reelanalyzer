# =============================================================
# ReelAnalyzer Environment Variables
# =============================================================

# ---- LLM (FREE) ----
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ---- YouTube Data API v3 (FREE) ----
# Get free key at: https://console.cloud.google.com
# Enable "YouTube Data API v3" → Credentials → Create API Key
# Free quota: 10,000 units/day = ~3,333 videos/day
YOUTUBE_API_KEY=your_youtube_api_key_here

# ---- Embeddings ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=./chroma_db

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Redis Password (for Upstash or managed Redis) ----
REDIS_PASSWORD=
REDIS_SSL=false
